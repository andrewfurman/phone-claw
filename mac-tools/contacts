#!/usr/bin/env python3
"""Read-only Apple Contacts lookups for PhoneClaw (#151).

Reads the local AddressBook SQLite stores (every account under ~/Library/Application Support/AddressBook/Sources)
with mode=ro, so it needs no Contacts automation permission and cannot change anything.

Usage:
  contacts search NAME [-l 1/2/3/5/10]   people whose name, nickname or company contains every word of NAME
Output: JSON {ok, query, matches: [{id, name, organization, phones: [{label, number}], emails: [{label, address}]}]}
"""
import glob, json, os, re, sqlite3, sys
LIMITS = {1, 2, 3, 5, 10}
BASE = os.path.expanduser("~/Library/Application Support/AddressBook")

def label(raw):
    t = re.sub(r"^_\$!<|>!\$_$", "", raw or "").strip()
    return t.lower() or "other"

def norm_phone(raw):
    digits = re.sub(r"[^\d+]", "", raw or "")
    if re.fullmatch(r"\+[1-9]\d{7,14}", digits): return digits
    if re.fullmatch(r"\d{10}", digits): return "+1" + digits
    if re.fullmatch(r"1\d{10}", digits): return "+" + digits
    return None

def search(query, limit):
    words = [w for w in re.split(r"\s+", query.strip().lower()) if w]
    if not words or len(query) > 80: raise ValueError("Give a name to look up (up to 80 characters).")
    people = {}
    for path in glob.glob(os.path.join(BASE, "Sources", "*", "AddressBook-v22.abcddb")) + glob.glob(os.path.join(BASE, "AddressBook-v22.abcddb")):
        db = sqlite3.connect("file:" + path + "?mode=ro", uri=True)
        rows = db.execute("select Z_PK, coalesce(ZFIRSTNAME,''), coalesce(ZLASTNAME,''), coalesce(ZNICKNAME,''), coalesce(ZORGANIZATION,''), ZUNIQUEID from ZABCDRECORD "
                          "where coalesce(ZFIRSTNAME,'')||coalesce(ZLASTNAME,'')||coalesce(ZORGANIZATION,'') != ''").fetchall()
        for pk, first, last, nick, org, uid in rows:
            hay = " ".join([first, last, nick, org]).lower()
            if not all(w in hay for w in words): continue
            name = " ".join(x for x in (first, last) if x) or org
            phones = [{"label": label(l), "number": n} for raw, l in db.execute("select ZFULLNUMBER, ZLABEL from ZABCDPHONENUMBER where ZOWNER = ?", (pk,)) for n in [norm_phone(raw)] if n]
            emails = [{"label": label(l), "address": a.lower()} for a, l in db.execute("select ZADDRESS, ZLABEL from ZABCDEMAILADDRESS where ZOWNER = ?", (pk,)) if a]
            handles = {p["number"] for p in phones} | {e["address"] for e in emails}
            # The same person often exists in two accounts (iCloud + Google): merge same-name cards that share
            # a phone or email, keep same-name strangers apart so ambiguity stays visible.
            entry = next((v for v in people.values() if v["name"].lower() == name.lower() and (not handles or not v["_handles"] or v["_handles"] & handles)), None)
            if entry is None:
                entry = {"id": (uid or str(pk)).split(":")[0][:12], "name": name, "organization": org if org != name else "", "phones": [], "emails": [], "_handles": set()}
                people[(name.lower(), len(people))] = entry
            entry["_handles"] |= handles
            for p in phones:
                if p["number"] not in [x["number"] for x in entry["phones"]]: entry["phones"].append(p)
            for e in emails:
                if e["address"] not in [x["address"] for x in entry["emails"]]: entry["emails"].append(e)
        db.close()
    exact = [p for p in people.values() if p["name"].lower() == query.strip().lower()]
    ranked = exact + sorted((p for p in people.values() if p not in exact), key=lambda p: (not p["phones"], p["name"]))
    for p in ranked: p.pop("_handles", None)
    return {"ok": True, "query": query, "total_matches": len(ranked), "matches": ranked[:limit]}

if __name__ == "__main__":
    args = sys.argv[1:]
    try:
        if not args or args[0] in ("help", "--help", "-h"): print(__doc__.strip()); sys.exit(0)
        if args[0] != "search": raise ValueError("Only `contacts search NAME` is supported.")
        limit, words, i = 5, [], 1
        while i < len(args):
            if args[i] in ("-l", "--limit"):
                if i + 1 >= len(args) or not args[i + 1].isdigit() or int(args[i + 1]) not in LIMITS: raise ValueError("Limit must be 1/2/3/5/10.")
                limit = int(args[i + 1]); i += 2; continue
            if args[i].startswith("-"): raise ValueError("Unknown flag.")
            words.append(args[i]); i += 1
        print(json.dumps(search(" ".join(words), limit), ensure_ascii=False))
    except (ValueError, sqlite3.Error) as e:
        print(json.dumps({"ok": False, "status": "contacts_failed", "message": str(e)})); sys.exit(1)
