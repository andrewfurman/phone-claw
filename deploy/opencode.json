{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "bash": {
      "*": "allow",
      "git reset --hard*": "deny",
      "gh pr merge*": "deny",
      "gh release*": "deny",
      "npm publish*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "shutdown*": "deny",
      "systemctl *": "deny",
      "git push*": "allow",
      "git push": "deny",
      "git push origin": "deny",
      "git push -u origin": "deny",
      "git push --set-upstream origin": "deny",
      "git push *--all*": "deny",
      "git push *--mirror*": "deny",
      "git push * main": "deny",
      "git push * main *": "deny",
      "git push * main:*": "deny",
      "git push *:main": "deny",
      "git push *:main *": "deny",
      "git push *refs/heads/main*": "deny",
      "git push * master": "deny",
      "git push * master *": "deny",
      "git push * master:*": "deny",
      "git push *:master": "deny",
      "git push *:master *": "deny",
      "git push *refs/heads/master*": "deny",
      "git push * dev": "deny",
      "git push * dev *": "deny",
      "git push * dev:*": "deny",
      "git push *:dev": "deny",
      "git push *:dev *": "deny",
      "git push *refs/heads/dev*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/var/lib/phoneclaw/claude-steering/*": "allow"
    }
  }
}
