{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "gh pr merge*": "deny",
      "gh release*": "deny",
      "npm publish*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "shutdown*": "deny",
      "systemctl *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/var/lib/phoneclaw/claude-steering/*": "allow"
    }
  }
}
