[Unit]
Description=Renew PhoneClaw's saved Outlook web sessions (tokens and sign-in cookies)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=phoneclaw
Group=phoneclaw
# The outlook-web-cli binary reads /home/phoneclaw/.config/outlook-web-cli (config.json + sessions).
# It needs no bridge secrets, so bridge.env is not loaded here.
Environment=HOME=/home/phoneclaw
WorkingDirectory=/home/phoneclaw
ExecStart=/usr/local/bin/outlook-web-cli auth refresh --all --rotate
TimeoutStartSec=300
